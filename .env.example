LLM_PROVIDER=openai
KNOWLEDGE_EMBEDDING_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
COMPANION_CLEAN_DISTRIBUTION=1
COMPANION_DEFAULT_CHARACTER=assistant
VOICE_PREFETCH_ENABLED=false
# Desktop API credentials are entered in Settings, not imported from this file.
# Standalone backend: copy this template into COMPANION_DATA_DIR/.env.
# Optional user-managed local voice environment. No model is redistributed.
VOICE_INDEX_MODEL_DIR=
VOICE_MODEL_DIR=
VOICE_REFERENCES_DIR=
